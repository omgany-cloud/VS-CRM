# Copy to .env and fill in. Get these from developer.x.com after creating
# an app with OAuth 2.0 enabled (User authentication settings -> Confidential
# client if you have a Client Secret, or Public client / PKCE-only otherwise).
#
# Reading the home timeline (reverse_chronological) requires a paid API
# access tier (Basic or higher) — the Free tier does not expose this
# endpoint at all, regardless of scopes granted.

# Required. From your X app's "Keys and tokens" -> OAuth 2.0 Client ID.
X_CLIENT_ID=

# Optional. Only set this if your app is a "Confidential client" (has a
# Client Secret). Leave blank for a Public client (PKCE only).
X_CLIENT_SECRET=

# Must exactly match a callback URL registered on your X app.
X_REDIRECT_URI=http://127.0.0.1:8787/callback

# Local port the temporary OAuth callback server listens on during `auth`.
# Must match the port in X_REDIRECT_URI above.
OAUTH_CALLBACK_PORT=8787

# Max pages of 100 tweets to pull per `analyze` run (rate-limit friendly).
MAX_PAGES=5
