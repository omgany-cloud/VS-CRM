# Copy this file to .env and fill in real values before deploying.
# .env is gitignored — never commit real secrets.

# Port the server listens on. Defaults to 4000 if unset.
PORT=4000

# Signs every JWT (internal user sessions + portal sessions). If unset,
# the server auto-generates and persists a random one at
# server/data/.jwt_secret on first run — fine for local use, but for a
# real deployment set this explicitly (e.g. from a secret manager) so
# the secret doesn't live on the same disk as the database it protects.
JWT_SECRET=

# Only needed once you have a real domain and a TLS certificate (e.g.
# via Let's Encrypt). If both are set, the server listens over HTTPS
# using these files instead of plain HTTP. See DEPLOYMENT.md.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Powers the onboarding "AI-assist" features (DD-conclusion drafts,
# document-data extraction, sanctions/PEP screening flags — see the
# aiAssist permission on the Users page) and the Sandbox document
# analysis ("Запустить ИИ-анализ" / "Проанализировать всю папку"). Unset
# by default: those routes return a clear "AI is not configured" error
# rather than silently doing nothing. 'anthropic' and 'openai' are both
# implemented (server/aiProvider.js); adding another provider means
# adding a branch there, not changing this variable's meaning.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Defaults to claude-sonnet-5 if left blank.
ANTHROPIC_MODEL=

# Used when AI_PROVIDER=openai. Also read by tools/astra.js (the
# dev-time "ask Astra" helper) — the same key/model work for both, since
# they're the same underlying account; nothing stops pointing them at
# different keys later if that's ever wanted.
OPENAI_API_KEY=
# Exact model ID to call — no default beyond gpt-4o if left blank, so a
# specific deployment (e.g. gpt-6-astra) should always be spelled out here.
OPENAI_MODEL=
# Optional — only for an OpenAI-compatible proxy/gateway. Defaults to
# https://api.openai.com/v1
OPENAI_BASE_URL=

# Outbound email for server/notifications/* (Capital Call created, your
# turn in a workflow approval, and — once Stage 2 lands — KYC renewal/
# document-expiry/regulator-deadline digests). Any standard SMTP provider
# works here (a corporate Exchange/Postfix relay, SendGrid, Postmark, AWS
# SES, ...) — nodemailer speaks plain SMTP, this app doesn't care which one
# is behind it. If SMTP_HOST is left blank, notifications are logged to the
# console instead of sent — same "safe default" as leaving JWT_SECRET
# unset, so local development never needs real mail credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Turan Capital Fund CRM <noreply@example.com>"

# Local hour (0-23, server time) digest-type notifications are allowed to
# send at — see server/notifications/scheduler.js. Defaults to 8 (08:00).
# System-wide for now, not per-tenant.
DIGEST_HOUR=

# Set to 1 ONLY when this server sits behind a reverse proxy (e.g. nginx)
# that terminates TLS/handles the public IP. Makes the app trust
# X-Forwarded-For so rate limiting and logging see the real client IP
# instead of the proxy's. Leave unset for local/direct use — enabling
# this without a real proxy in front lets a client fake its own IP and
# bypass login rate limiting.
TRUST_PROXY=

# Lets Sandbox ("Песочница") projects pull documents straight off a folder
# that already lives on THIS SERVER's own disk — e.g. a mapped network
# share, or a Drive/OneDrive desktop client synced on the server itself.
# This is NOT a way to read a file from a staff member's own computer —
# no website can reach into a visitor's local filesystem, browsers don't
# allow it. Point this at the one shared root folder on the server (e.g.
# Z:\Deals or /mnt/company-drive/Deals); each project then stores its own
# path RELATIVE to this root. Unset by default: the local-files routes
# return a clear "not configured" error and the whole section stays
# hidden in the UI, same safe-default pattern as AI_PROVIDER/JWT_SECRET.
SANDBOX_FILES_ROOT=
